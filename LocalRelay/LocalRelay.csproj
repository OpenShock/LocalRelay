<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OpenShockModuleId>openshock.localrelay</OpenShockModuleId>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>OpenShock.LocalRelay</AssemblyName>
        <RootNamespace>OpenShock.LocalRelay</RootNamespace>
        <Company>OpenShock</Company>
        <AssemblyVersion>1.2.0.0</AssemblyVersion>
        
        <Version>1.2.0</Version>
        <Product>LocalRelay</Product>
        <TargetFramework>net10.0</TargetFramework>

        <Configurations>Release;Debug</Configurations>

        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <!-- ModuleBase lists LucHeart.WebsocketLibrary as host-provided at 1.1.0, so the packer strips
         it from the module. We need 1.2.0, so force our own copy into libs/ until the host ships it. -->
    <ItemGroup>
        <OpenShockBundleOverride Include="LucHeart.WebsocketLibrary" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CircularBuffer" Version="1.4.0" />
        <PackageReference Include="LucHeart.WebsocketLibrary" Version="1.2.0" />
        <PackageReference Include="LucHeart.WebsocketLibrary.Flatbuffers" Version="1.2.0" />
        <PackageReference Include="OpenShock.Desktop.ModuleBase" Version="1.3.0" />
        <PackageReference Include="OpenShock.Internal.Common" Version="1.1.0" />
        <PackageReference Include="OpenShock.SDK.CSharp" Version="0.0.42" />
        <PackageReference Include="OpenShock.SDK.CSharp.Live" Version="0.0.42" />
        <PackageReference Include="OpenShock.Serialization.Flatbuffers" Version="2.1.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="System.IO.Ports" Version="10.0.11" />
        <PackageReference Include="MudBlazor" Version="9.9.0" />
        <PackageReference Include="Semver" Version="3.0.0" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\images\Icon.svg" />
      <_ContentIncludedByDefault Remove="wwwroot\images\Icon512.png" />
      <_ContentIncludedByDefault Remove="wwwroot\images\Icon64.png" />
      <_ContentIncludedByDefault Remove="wwwroot\images\IconLoadingSpin.svg" />
      <_ContentIncludedByDefault Remove="wwwroot\images\IconSlowSpin.svg" />
      <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
      <UpToDateCheckInput Remove="Ui\Pages\Authentication\Authenticate.razor" />
      <UpToDateCheckInput Remove="Ui\Pages\Authentication\LoginPart.razor" />
      <UpToDateCheckInput Remove="Ui\Pages\Authentication\NotAuthedLayout.razor" />
      <UpToDateCheckInput Remove="Ui\ErrorHandling\CodeBlock.razor" />
      <UpToDateCheckInput Remove="Ui\ErrorHandling\ContainerWithExceptionHandling.razor" />
      <UpToDateCheckInput Remove="Ui\ErrorHandling\ExceptionView.razor" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resources\LocalRelay-Icon.png" />
      <EmbeddedResource Include="Resources\LocalRelay-Icon.png" />
    </ItemGroup>
    
    <Target Name="CopyModuleToDesktop" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <PropertyGroup>
            <ModuleDestDir>$(APPDATA)\OpenShock\Desktop\modules\$(OpenShockModuleId)\</ModuleDestDir>
        </PropertyGroup>
        <MakeDir Directories="$(ModuleDestDir)" Condition="!Exists('$(ModuleDestDir)')" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleDestDir)" />
    </Target>


</Project>
