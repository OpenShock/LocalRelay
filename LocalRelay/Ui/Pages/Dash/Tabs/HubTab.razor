@using LucHeart.WebsocketLibrary
@using OpenShock.Desktop.ModuleBase
@using OpenShock.Desktop.ModuleBase.Api
@using OpenShock.LocalRelay.Services
@using OpenShock.LocalRelay.Ui.Components
@implements IAsyncDisposable

@page "/dash/hub"

<PageContainer MaxWidth="@PageContainer.NarrowWidth">

    @* The page title is the answer to the question you opened the tab to ask. *@
    <TitleContent>
        <div class="d-flex align-center gap-4">
            <span class="@BeaconClass" style="@($"color: var(--mud-palette-{BeaconPalette});")"></span>
            <div>
                <MudText Typo="Typo.h5">@StatusHeadline</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@StatusDetail</MudText>
            </div>
        </div>
    </TitleContent>

    <ChildContent>

        <SectionCard Icon="@Icons.Material.Filled.Hub" Title="Hub">
            <HeaderContent>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@ConnectionState</MudText>
            </HeaderContent>
            <ChildContent>
                <LabeledRow Label="Relayed hub"
                            Description="The hub this machine pretends to be. Its commands get forwarded to the serial device.">
                    <MudSelect T="Guid" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Style="width: 240px;" @bind-Value="_selectedDevice"
                               @bind-Value:after="SelectedDeviceChanged">
                        <MudSelectItem Value="Guid.Empty">None (Disable)</MudSelectItem>
                        @foreach (var device in OpenShockService.Data.Hubs.Value)
                        {
                            <MudSelectItem Value="@device.Id">@device.Name</MudSelectItem>
                        }
                    </MudSelect>
                </LabeledRow>
            </ChildContent>
        </SectionCard>

    </ChildContent>

</PageContainer>

@code {

    [ModuleInject] private IOpenShockService OpenShockService { get; set; } = null!;
    [ModuleInject] private FlowManager FlowManager { get; set; } = null!;

    private Guid _selectedDevice = Guid.Empty;
    private IAsyncDisposable _flowUpdatedSubscription = null!;

    protected override async Task OnInitializedAsync()
    {
        _selectedDevice = FlowManager.HubId;

        _flowUpdatedSubscription = await FlowManager.State.Updated.SubscribeAsync(state => InvokeAsync(StateHasChanged));
    }

    #region Status

    private WebsocketConnectionState ConnectionState => FlowManager.State.Value;

    private bool HubSelected => _selectedDevice != Guid.Empty;

    private string StatusHeadline
    {
        get
        {
            if (!HubSelected) return "No hub selected";

            return ConnectionState switch
            {
                WebsocketConnectionState.Connected => "Relaying",
                WebsocketConnectionState.Connecting => "Connecting",
                WebsocketConnectionState.WaitingForReconnect => "Reconnecting",
                _ => "Not connected"
            };
        }
    }

    private string StatusDetail
    {
        get
        {
            if (!HubSelected) return "Pick a hub below to start relaying its commands.";

            return ConnectionState switch
            {
                WebsocketConnectionState.Connected => "Connected to the gateway, commands are being forwarded.",
                WebsocketConnectionState.Connecting => "Reaching the OpenShock gateway.",
                WebsocketConnectionState.WaitingForReconnect => "Lost the gateway, backing off before the next try.",
                _ => "Not connected to the OpenShock gateway."
            };
        }
    }

    /// <summary>Pulses while a connection is being worked on, so waiting reads as activity.</summary>
    private string BeaconClass =>
        ConnectionState is WebsocketConnectionState.Connecting or WebsocketConnectionState.WaitingForReconnect
            ? "status-beacon pulsing"
            : "status-beacon";

    private string BeaconPalette
    {
        get
        {
            if (!HubSelected) return "info";

            return ConnectionState switch
            {
                WebsocketConnectionState.Connected => "success",
                WebsocketConnectionState.Connecting or WebsocketConnectionState.WaitingForReconnect => "warning",
                _ => "error"
            };
        }
    }

    #endregion

    private async Task SelectedDeviceChanged()
    {
        await FlowManager.SelectedDeviceChanged(_selectedDevice);
    }

    public async ValueTask DisposeAsync()
    {
        await _flowUpdatedSubscription.DisposeAsync();
    }

}
